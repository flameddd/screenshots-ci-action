{
  "name": "screenshots-ci-action",
  "version": "2.0.0",
  "description": "Github Actions to screenshots website",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint index.js telegram.js --fix",
    "build": "npm run lint && rm -rf dist && ncc build index.cjs -o dist -m",
    "prepare": "husky"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "screenshot"
  ],
  "author": "GitHub",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/flameddd/screenshots-ci-action"
  },
  "homepage": "https://github.com/flameddd/screenshots-ci-action",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "node-telegram-bot-api": "^2.1.0",
    "puppeteer": "^25.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  }
}
